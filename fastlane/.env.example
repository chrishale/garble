# Copy to fastlane/.env (gitignored) and fill in.
# Local devs only — CI uses GitHub Secrets with the same variable names.

# Shorebird (required)
SHOREBIRD_TOKEN=

# App Store Connect API (required for `fastlane ios beta`)
APPSTORE_ISSUER_ID=
APPSTORE_API_KEY_ID=
# Either inline the .p8 contents...
# APPSTORE_API_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# ...or point to a local file (preferred locally — local convenience env var, not used by CI):
APPSTORE_API_PRIVATE_KEY_PATH=/absolute/path/to/AuthKey_XXXXXXXX.p8

# Play Console (required for `fastlane android internal`)
# Either inline the JSON via PLAY_SERVICE_ACCOUNT_JSON, or point to a local file:
PLAY_SERVICE_ACCOUNT_JSON_PATH=/absolute/path/to/play-service-account.json
